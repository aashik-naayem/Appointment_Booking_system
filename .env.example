# ============================================================
# BookFlow Environment Variables
# Copy this file to .env.local and fill in all values
# NEVER commit .env.local to version control
# ============================================================

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BookFlow

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL="postgresql://bookflow:password@localhost:5432/bookflow?schema=public"
DIRECT_URL="postgresql://bookflow:password@localhost:5432/bookflow?schema=public"

# ============================================================
# AUTHENTICATION (Auth.js / next-auth)
# ============================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-chars-long

# Google OAuth
# Optional. Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# STRIPE
# ============================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_YEARLY_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_...
STRIPE_BUSINESS_YEARLY_PRICE_ID=price_...

# ============================================================
# EMAIL (Resend)
# ============================================================
RESEND_API_KEY=re_...
EMAIL_FROM=BookFlow <noreply@bookflow.app>
EMAIL_REPLY_TO=support@bookflow.app

# ============================================================
# SMS/WHATSAPP (Twilio)
# ============================================================
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
TWILIO_WHATSAPP_NUMBER=whatsapp:+1...

# ============================================================
# GOOGLE CALENDAR
# ============================================================
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# ============================================================
# REDIS / UPSTASH
# ============================================================
# Optional. Leave BOTH blank for local development (an in-memory rate limiter is used).
# Do not put placeholder text here - set real Upstash values or nothing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# BACKGROUND JOBS (Inngest)
# ============================================================
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# ============================================================
# ERROR MONITORING (Sentry)
# ============================================================
SENTRY_DSN=https://...@....ingest.sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=bookflow-web
SENTRY_AUTH_TOKEN=...

# ============================================================
# ENCRYPTION
# ============================================================
# Used to encrypt OAuth tokens stored in database
ENCRYPTION_KEY=your-32-char-encryption-key-here!!

# ============================================================
# SUPER ADMIN
# ============================================================
SUPER_ADMIN_EMAIL=admin@bookflow.app

# ============================================================
# RATE LIMITING
# ============================================================
# Max booking attempts per IP per hour
RATE_LIMIT_BOOKING_MAX=10
RATE_LIMIT_AUTH_MAX=5
