// BookFlow - Prisma schema (full: 22 models, matches migration 20261010200930_init)
// Generated client lives in packages/database/src/generated/client

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  STAFF
}

enum SubscriptionPlan {
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
  PUSH
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  BOOKING_CANCELLATION
  BOOKING_RESCHEDULED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  REVIEW_REQUEST
  STAFF_NEW_BOOKING
  STAFF_CANCELLATION
  WELCOME
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  IMPERSONATE
  EXPORT
  IMPORT
  STRIPE_WEBHOOK
  API_CALL
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  BLACKLISTED
  VIP
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// ============================================================
// TENANT
// ============================================================

model Tenant {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  description       String?
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String    @default("#6366f1")
  secondaryColor    String    @default("#f59e0b")
  accentColor       String    @default("#10b981")
  coverImageUrl     String?
  email             String?
  phone             String?
  website           String?
  address           String?
  city              String?
  state             String?
  country           String    @default("US")
  postalCode        String?
  timezone          String    @default("UTC")
  currency          String    @default("USD")
  locale            String    @default("en")
  bookingLeadTime   Int       @default(60)
  bookingWindowDays Int       @default(60)
  cancellationHours Int       @default(24)
  requireDeposit    Boolean   @default(false)
  depositPercentage Decimal   @default(0) @db.Decimal(5, 2)
  autoConfirm       Boolean   @default(true)
  allowGuestBooking Boolean   @default(true)
  customDomain      String?   @unique
  isPublic          Boolean   @default(true)
  isActive          Boolean   @default(true)
  stripeCustomerId  String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  users             User[]
  staff             Staff[]
  services          Service[]
  serviceCategories ServiceCategory[]
  customers         Customer[]
  appointments      Appointment[]
  businessHours     BusinessHours[]
  holidays          Holiday[]
  subscription      Subscription?
  payments          Payment[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  auditLogs         AuditLog[]
  apiKeys           ApiKey[]
  featureFlags      FeatureFlag[]

  @@index([slug])
  @@index([stripeCustomerId])
  @@index([customDomain])
}

// ============================================================
// AUTH (Auth.js / next-auth + @auth/prisma-adapter)
// ============================================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  emailVerified      DateTime?
  name               String?
  image              String?
  password           String?
  role               UserRole  @default(STAFF)
  tenantId           String?
  phone              String?
  bio                String?
  timezone           String?
  locale             String    @default("en")
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecret    String?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  accounts      Account[]
  sessions      Session[]
  staff         Staff?
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([email])
  @@index([tenantId])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// STAFF
// ============================================================

model Staff {
  id             String      @id @default(cuid())
  tenantId       String
  userId         String?     @unique
  name           String
  email          String
  phone          String?
  bio            String?
  avatarUrl      String?
  title          String?
  status         StaffStatus @default(ACTIVE)
  color          String?
  commission     Decimal     @default(0) @db.Decimal(5, 2)
  hasCustomHours Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  workingHours        StaffWorkingHours[]
  services            StaffService[]
  appointments        Appointment[]
  notifications       Notification[]
  calendarConnections CalendarConnection[]

  @@index([tenantId])
  @@index([email])
}

model StaffWorkingHours {
  id        String    @id @default(cuid())
  staffId   String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  isWorking Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

model StaffService {
  id        String @id @default(cuid())
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

// ============================================================
// SERVICES
// ============================================================

model Service {
  id            String    @id @default(cuid())
  tenantId      String
  categoryId    String?
  name          String
  description   String?
  imageUrl      String?
  duration      Int
  bufferTime    Int       @default(0)
  price         Decimal   @db.Decimal(10, 2)
  depositAmount Decimal?  @db.Decimal(10, 2)
  maxConcurrent Int       @default(1)
  isActive      Boolean   @default(true)
  requiresStaff Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staff        StaffService[]
  appointments Appointment[]

  @@index([tenantId])
  @@index([categoryId])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id                String              @id @default(cuid())
  tenantId          String
  userId            String?
  name              String
  email             String
  phone             String?
  notes             String?
  status            CustomerStatus      @default(ACTIVE)
  blacklistReason   String?
  totalBookings     Int                 @default(0)
  completedBookings Int                 @default(0)
  noShowCount       Int                 @default(0)
  totalSpent        Decimal             @default(0) @db.Decimal(10, 2)
  lastVisitAt       DateTime?
  allowMarketing    Boolean             @default(true)
  preferredChannel  NotificationChannel @default(EMAIL)
  stripeCustomerId  String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  payments      Payment[]
  notifications Notification[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

// ============================================================
// APPOINTMENTS
// ============================================================

model Appointment {
  id                 String            @id @default(cuid())
  tenantId           String
  serviceId          String
  staffId            String?
  customerId         String
  startTime          DateTime
  endTime            DateTime
  timezone           String
  duration           Int
  status             AppointmentStatus @default(PENDING)
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  noShowAt           DateTime?
  completedAt        DateTime?
  confirmedAt        DateTime?
  servicePrice       Decimal           @db.Decimal(10, 2)
  depositAmount      Decimal           @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal           @db.Decimal(10, 2)
  discount           Decimal           @default(0) @db.Decimal(10, 2)
  customerNotes      String?
  internalNotes      String?
  bookingReference   String            @unique @default(cuid())
  rescheduledFromId  String?
  calendarEventId    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service         Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff           Staff?         @relation(fields: [staffId], references: [id], onDelete: SetNull)
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  rescheduledFrom Appointment?   @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Appointment[]  @relation("Reschedule")
  payment         Payment?
  notifications   Notification[]

  @@index([tenantId])
  @@index([staffId])
  @@index([customerId])
  @@index([serviceId])
  @@index([startTime])
  @@index([status])
  @@index([bookingReference])
  @@index([tenantId, startTime])
  @@index([tenantId, staffId, startTime])
}

// ============================================================
// BUSINESS HOURS / HOLIDAYS
// ============================================================

model BusinessHours {
  id        String    @id @default(cuid())
  tenantId  String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  isOpen    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model Holiday {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  date      DateTime @db.Date
  recurring Boolean  @default(false)
  isAllDay  Boolean  @default(true)
  startTime String?
  endTime   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, date])
}

// ============================================================
// BILLING
// ============================================================

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  stripeSubscriptionId String             @unique
  stripeCustomerId     String
  stripePriceId        String
  stripeProductId      String
  plan                 SubscriptionPlan
  status               SubscriptionStatus
  interval             String
  trialStart           DateTime?
  trialEnd             DateTime?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  endedAt              DateTime?
  gracePeriodEnd       DateTime?
  maxStaff             Int?
  maxBookings          Int?
  bookingsThisMonth    Int                @default(0)
  periodResetAt        DateTime?
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
}

model Payment {
  id                    String        @id @default(cuid())
  tenantId              String
  appointmentId         String?       @unique
  customerId            String?
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  stripeRefundId        String?
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  description           String?
  paidAt                DateTime?
  refundedAt            DateTime?
  refundAmount          Decimal?      @db.Decimal(10, 2)
  failureReason         String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@index([stripePaymentIntentId])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id              String              @id @default(cuid())
  tenantId        String
  appointmentId   String?
  customerId      String?
  staffId         String?
  recipientUserId String?
  type            NotificationType
  channel         NotificationChannel
  status          NotificationStatus  @default(PENDING)
  recipient       String
  subject         String?
  body            String
  scheduledFor    DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  retryCount      Int                 @default(0)
  maxRetries      Int                 @default(3)
  externalId      String?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staff         Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  recipientUser User?        @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([appointmentId])
  @@index([status])
  @@index([scheduledFor])
}

model NotificationPreference {
  id                  String              @id @default(cuid())
  tenantId            String
  type                NotificationType
  channel             NotificationChannel
  enabled             Boolean             @default(true)
  hoursBeforeReminder Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, channel])
  @@index([tenantId])
}

// ============================================================
// INTEGRATIONS / PLATFORM
// ============================================================

model CalendarConnection {
  id           String    @id @default(cuid())
  staffId      String
  provider     String    @default("google")
  calendarId   String?
  calendarName String?
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  scope        String?
  isActive     Boolean   @default(true)
  lastSyncAt   DateTime?
  syncError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, provider])
  @@index([staffId])
}

model AuditLog {
  id          String      @id @default(cuid())
  tenantId    String?
  userId      String?
  action      AuditAction
  resource    String
  resourceId  String?
  description String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  severity    String      @default("info")
  createdAt   DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model ApiKey {
  id         String       @id @default(cuid())
  tenantId   String
  name       String
  keyHash    String       @unique
  keyPrefix  String
  status     ApiKeyStatus @default(ACTIVE)
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  revokedBy  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyHash])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  enabled   Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}
