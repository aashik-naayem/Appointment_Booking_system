{
  "name": "@bookflow/database",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate dev",
    "db:migrate:prod": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env.local -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env.local -e ../../.env -- prisma studio",
    "db:reset": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate reset --force",
    "auth:doctor": "dotenv -e ../../.env.local -e ../../.env -- tsx scripts/auth-doctor.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "dotenv-cli": "^7.4.4",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts",
    "schema": "prisma/schema.prisma"
  }
}
